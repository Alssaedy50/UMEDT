# UMED-2 — Environment Variables Template
# Copy to .env for local development. Never commit real API keys or private keys to Git.

# ==============================================================================
# 1. CLIENT / BUNDLE CONFIGURATION (Prefixed with VITE_ — Safe for Frontend)
# ==============================================================================

# Public HTTPS URL to the production Cloudflare R2 manifest.json
# Example: https://data.umed2.org/stable/manifest.json OR https://pub-xxxx.r2.dev/stable/manifest.json
# Leave empty to keep optional CDN medical-data updates disabled by default in local builds.
VITE_UMED_MANIFEST_URL=

# SPKI Public Key PEM for verifying ECDSA-P256-SHA256 signed data packages
# CRITICAL SECURITY RULE: NEVER put a PRIVATE KEY here. Only put the public key (SPKI PEM).
# When embedded at build time, this key becomes the authoritative trusted key and cannot be overridden by localStorage.
VITE_UMED_PUBLIC_KEY_PEM=

# ==============================================================================
# 2. LOCAL DEV EXPRESS SERVER ONLY (Never exposed in frontend client bundle)
# ==============================================================================

# Optional: Server-side Gemini API key used by Express server.ts in local full-stack mode
GEMINI_API_KEY=

# ==============================================================================
# 3. RELEASE PUBLISHER & CLOUDFLARE R2 (CI / GitHub Actions Secrets & Variables)
# ==============================================================================

# GitHub Actions Secret: Permanent ECDSA-P256 Private Key in PKCS#8 PEM format
# NEVER prefix with VITE_ and NEVER commit a real private key to Git.
UMED_PUBLISHER_PRIVATE_KEY_PEM=

# GitHub Actions Secret: Cloudflare API Token with scoped 'Object Read & Write' permission for the R2 bucket
CLOUDFLARE_API_TOKEN=

# GitHub Actions Secret: Cloudflare Account ID (32-character hex identifier from Cloudflare Dashboard)
CLOUDFLARE_ACCOUNT_ID=

# GitHub Actions Variable: Cloudflare R2 Bucket name (e.g., umed2-medical-data)
UMED_R2_BUCKET=umed2-medical-data

# GitHub Actions Variable: Public HTTPS Custom Domain or R2 Public Bucket Base URL
# Example: https://data.umed2.org OR https://pub-xxxx.r2.dev
UMED_R2_PUBLIC_BASE_URL=

# Optional Release Defaults:
UMED_RELEASE_CHANNEL=stable
# UMED_RELEASE_VERSION=2026.11.0-umd
# UMED_RELEASE_SUMMARY="إصدار طبي معتمد"
